# segreti
.env

# dati del cliente: tutto cio che e mutevole e di proprieta di chi installa.
# kb.db, KB markdown, sorgenti ingerite, report, config compilata, log.
# Va backuppato a parte, NON viaggia col pacchetto distribuibile.
data/*
!data/.gitkeep

# fixtures pesanti dei test: tracciati a parte, non in git
tests/fixtures/html/*
tests/fixtures/pdf/**/*.pdf
tests/fixtures/rss/*
!tests/fixtures/**/.gitkeep
tests/test_runs/*.jsonl

# python / uv
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
