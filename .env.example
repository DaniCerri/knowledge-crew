# Copia in .env e compila. .env NON va in git.

# --- Cloud LLM (compile + weekly synthesis) ---
ANTHROPIC_API_KEY=

# --- Discovery opzionale ---
FIRECRAWL_API_KEY=

# --- Newsletter via email (casella dedicata) ---
# Gmail API: path al file di credenziali OAuth scaricato dalla console Google
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=
# In alternativa IMAP semplice
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# --- Delivery ---
# SMTP per inviare il daily digest a se stessi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO_ADDRESS=

# Telegram bot per topic alerts urgenti (opzionale)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Servizi locali ---
OLLAMA_HOST=http://localhost:11434
SEARXNG_URL=http://localhost:8080
